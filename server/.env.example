# ==============================================================================
# AirAware AI Backend — Render & Server Environment Variables
# ==============================================================================
# Configure these variables in your Render Web Service Dashboard (Environment tab)
# ==============================================================================

# Runtime Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origin: URL of your deployed Vercel frontend (supports comma-separated list)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# MongoDB Atlas Database URI (Required in production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/airaware?retryWrites=true&w=majority
MONGO_URI=

# JWT Authentication Secret (Required in production, minimum 32 random characters)
JWT_SECRET=generate_a_random_32_character_secret_key_here
JWT_EXPIRES_IN=7d

# OpenAI GPT API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap API Key (Optional secondary fallback)
OPENWEATHER_API_KEY=
