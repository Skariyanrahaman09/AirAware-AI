# ==========================================
# AirAware AI - Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS)
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection URI
# Leave empty to automatically launch in-memory MongoDB (works out-of-the-box with zero setup)
# Or provide your MongoDB connection string (e.g. mongodb://localhost:27017/airaware or Atlas URI)
MONGO_URI=

# JWT Authentication
JWT_SECRET=airaware_ai_secure_jwt_secret_dev_2026
JWT_EXPIRES_IN=7d

# OpenAI API Key (Optional)
# If provided, uses OpenAI GPT models for natural language reasoning.
# If not provided, AirAware AI uses its built-in expert environmental intelligence engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External Air Quality API (Optional)
# Open-Meteo Air Quality & Weather API is used by default (free, high-precision, no key required).
# Optionally provide OpenWeatherMap API key:
OPENWEATHER_API_KEY=

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
