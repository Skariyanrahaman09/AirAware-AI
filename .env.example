# ==============================================================================
# AirAware AI — Production & Local Environment Variables Reference
# ==============================================================================
# Copy this file to .env for local full-stack development, or configure the
# respective keys in your cloud hosting provider dashboards:
# - Backend variables -> Render Service Environment Variables
# - Frontend variables -> Vercel Project Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Render / Node.js)
# ------------------------------------------------------------------------------
# In production on Render:
# - Set NODE_ENV=production
# - PORT is provided automatically by Render (defaults to 5000 locally)
# - Set HOST=0.0.0.0
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS ALLOWED ORIGINS (Render)
# ------------------------------------------------------------------------------
# The public URL of your deployed Vercel frontend.
# Supports a single URL or comma-separated origins.
# Example: https://airaware-ai.vercel.app,https://your-custom-domain.com
# NOTE: Never set to '*' in production.
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (MongoDB Atlas / Render)
# ------------------------------------------------------------------------------
# MongoDB connection URI:
# - Production: Required! Use MongoDB Atlas connection string:
#   mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/airaware?retryWrites=true&w=majority
# - Development: Leave blank to automatically use local in-memory MongoDB.
MONGO_URI=

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECURITY (Render)
# ------------------------------------------------------------------------------
# Secret key for signing and verifying JWT tokens.
# Production Requirement: Minimum 32 characters of high-entropy random characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. GENAI / OPENAI INTEGRATION (Render — Optional)
# ------------------------------------------------------------------------------
# If provided, uses OpenAI GPT models for context-aware environmental recommendations.
# If omitted or empty, AirAware AI automatically uses its built-in rule-based
# environmental reasoning engine with zero interruption.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. EXTERNAL AIR QUALITY & WEATHER APIS (Render — Optional)
# ------------------------------------------------------------------------------
# Open-Meteo API is active by default (free, high-precision, no API key required).
# Optional secondary fallback:
OPENWEATHER_API_KEY=

# ------------------------------------------------------------------------------
# 7. CLIENT CONFIGURATION (Vercel / Next.js)
# ------------------------------------------------------------------------------
# The public URL of your deployed Render backend API.
# - Production (Vercel): https://your-backend-service.onrender.com
# - Local Development: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
